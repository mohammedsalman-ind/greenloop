{
  "name": "greenloop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace @greenloop/frontend",
    "dev:backend": "npm run dev --workspace @greenloop/backend",
    "build": "npm run build --workspace @greenloop/frontend",
    "lint": "npm run lint --workspace @greenloop/frontend",
    "check:backend": "npm run check --workspace @greenloop/backend",
    "test:backend": "npm run test --workspace @greenloop/backend",
    "audit:http": "node scripts/audit-http.mjs",
    "start": "npm run start --workspace @greenloop/backend"
  },
  "overrides": {
    "react-helmet-async": {
      "react": "^16.8.0 || ^17 || ^18 || ^19"
    }
  }
}
