{
  "name": "@greenloop/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/server.mjs",
    "start": "node --env-file-if-exists=../.env src/server.mjs",
    "test": "node --test tests/backend.test.mjs tests/audit.test.mjs tests/crud.test.mjs tests/qa-regressions.test.mjs tests/facility-research.test.mjs tests/facility-public-research.test.mjs",
    "check": "tsc -p tsconfig.json",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "db:migrate": "node --env-file-if-exists=../.env scripts/migrate-postgres.mjs",
    "db:import": "node --env-file-if-exists=../.env scripts/migrate-sqlite.mjs",
    "test:postgres": "node scripts/test-postgres.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.4.1",
    "typescript": "^5.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "pg": "^8.23.1"
  }
}
